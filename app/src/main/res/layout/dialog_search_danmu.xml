<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_960"
        android:layout_height="@dimen/vs_530"
        android:layout_gravity="center"
        android:background="@drawable/shape_live_channel_num"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/vs_15"
            android:text="在线搜索弹幕"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputDanmuSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_search"
                android:hint="请输入影片名称"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:singleLine="true"
                android:padding="@dimen/vs_12"
                android:textColor="@color/color_FFFFFF"
                android:textColorHint="@color/color_6CFFFFFF"
                android:textSize="@dimen/ts_24" />

            <TextView
                android:id="@+id/btnDanmuSearch"
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_50"
                android:layout_marginStart="@dimen/vs_10"
                android:background="@drawable/button_dialog_vod"
                android:focusable="true"
                android:gravity="center"
                android:text="搜索"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/btnDanmuSearchConfig"
                android:layout_width="@dimen/vs_140"
                android:layout_height="@dimen/vs_50"
                android:layout_marginStart="@dimen/vs_10"
                android:background="@drawable/button_dialog_vod"
                android:focusable="true"
                android:gravity="center"
                android:text="弹幕源设置"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDanmuSearchStatus"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_40"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/btnDanmuSearchBack"
                android:layout_width="@dimen/vs_100"
                android:layout_height="@dimen/vs_40"
                android:background="@drawable/button_dialog_vod"
                android:focusable="true"
                android:gravity="center"
                android:text="返回作品"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_18"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbDanmuSearch"
                android:layout_width="@dimen/vs_35"
                android:layout_height="@dimen/vs_35"
                android:layout_marginStart="@dimen/vs_10"
                android:indeterminateDrawable="@drawable/anim_loading"
                android:visibility="gone" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/listDanmuSearch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_10"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
    </LinearLayout>
</FrameLayout>
